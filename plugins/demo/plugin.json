{
  "id": "demo",
  "name": "示例插件",
  "version": "0.1.0",
  "description": "最小的插件示例：只写一行日志，用来验证加载链路通不通。可以照着它写自己的。",
  "author": "内置示例",
  "entry": "index.mjs",
  "configSchema": {
    "说明": {
      "type": "string",
      "label": "说明文字",
      "default": "demo 的配置会原样传进 ctx.config",
      "hint": "随便写点什么，只是演示"
    },
    "示例数字": {
      "type": "number",
      "label": "示例数字",
      "default": 42,
      "min": 0,
      "max": 1000,
      "hint": "0 到 1000 之间"
    },
    "模式": {
      "type": "select",
      "label": "运行模式",
      "options": ["宽松", "标准", "严格"],
      "default": "标准",
      "hint": "演示下拉框"
    }
  }
}
