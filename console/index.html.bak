<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>QQ Bot 控制台</title>
<style>
  :root{
    --bg:#0d1117; --panel:#161b22; --panel2:#1c2230; --line:#2a3040;
    --text:#e6edf3; --dim:#8b949e; --dim2:#6e7681;
    --green:#3fb950; --red:#f85149; --blue:#58a6ff; --purple:#bc8cff;
    --yellow:#d29922; --pink:#f778ba;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  body{background:var(--bg);color:var(--text);font:14px/1.6 "Segoe UI","Microsoft YaHei",system-ui,sans-serif;display:flex;height:100vh;overflow:hidden}
  aside{width:196px;background:var(--panel);border-right:1px solid var(--line);display:flex;flex-direction:column;flex-shrink:0}
  .brand{padding:18px 16px 14px;border-bottom:1px solid var(--line)}
  .brand h1{font-size:15px;font-weight:600}
  .brand p{font-size:11px;color:var(--dim2);margin-top:2px}
  nav{padding:10px 8px;flex:1}
  nav button{display:flex;align-items:center;gap:9px;width:100%;background:none;border:0;color:var(--dim);text-align:left;padding:9px 10px;border-radius:6px;cursor:pointer;font-size:13.5px;font-family:inherit}
  nav button:hover{background:var(--panel2);color:var(--text)}
  nav button.on{background:#1f6feb22;color:var(--blue);box-shadow:inset 2px 0 0 var(--blue)}
  nav .ico{width:16px;text-align:center;opacity:.9}
  .foot{border-top:1px solid var(--line);padding:10px 14px;font-size:11px;color:var(--dim2)}
  .dot{display:inline-block;width:7px;height:7px;border-radius:50%;background:var(--green);margin-right:6px}
  .dot.off{background:var(--red)}
  main{flex:1;display:flex;flex-direction:column;overflow:hidden}
  header{display:flex;align-items:center;gap:16px;padding:0 20px;height:52px;border-bottom:1px solid var(--line);background:var(--panel);flex-shrink:0}
  header .t{font-size:14px;font-weight:600}
  header .meta{margin-left:auto;display:flex;gap:16px;font-size:12px;color:var(--dim)}
  header .meta b{color:var(--text);font-weight:500}
  .views{flex:1;overflow-y:auto;padding:20px}
  .view{display:none;animation:fade .18s}
  .view.on{display:block}
  @keyframes fade{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:none}}
  .cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:12px;margin-bottom:16px}
  .card{background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:14px 16px}
  .card .k{font-size:12px;color:var(--dim2);margin-bottom:6px}
  .card .v{font-size:24px;font-weight:600}
  .card .v small{font-size:13px;color:var(--dim);font-weight:400}
  .card .s{font-size:11.5px;color:var(--dim);margin-top:4px}
  .grid2{display:grid;grid-template-columns:1.2fr 1fr;gap:12px}
  .panel{background:var(--panel);border:1px solid var(--line);border-radius:10px;overflow:hidden}
  .panel h3{font-size:12.5px;font-weight:600;color:var(--dim);padding:11px 16px;border-bottom:1px solid var(--line);display:flex;align-items:center;gap:8px}
  .panel h3 .r{margin-left:auto;font-weight:400;font-size:11px;color:var(--dim2)}
  .panel .body{padding:14px 16px}
  .bar{height:6px;background:#21262d;border-radius:3px;overflow:hidden;margin:8px 0 6px}
  .bar i{display:block;height:100%;background:linear-gradient(90deg,#a0325f,#f778ba)}
  .log{font:12.5px/1.85 ui-monospace,Consolas,monospace;max-height:calc(100vh - 190px);overflow-y:auto}
  .log div{display:flex;gap:10px;padding:1px 0}
  .log .ts{color:var(--dim2);flex-shrink:0}
  .log .lvl{flex-shrink:0;width:44px}
  .log .info{color:var(--blue)} .log .warn{color:var(--yellow)} .log .error{color:var(--red)}
  .item{display:flex;gap:10px;padding:9px 0;border-bottom:1px solid #21262d}
  .item:last-child{border-bottom:0}
  .item .tag{font-size:10.5px;padding:1px 7px;border-radius:5px;height:fit-content;background:#1f6feb22;color:var(--blue);flex-shrink:0;margin-top:2px}
  .item .tag.warn{background:#d2992222;color:var(--yellow)}
  .item .tag.pink{background:#f778ba22;color:var(--pink)}
  .item .tag.good{background:#3fb95022;color:var(--green)}
  .item .txt{font-size:13px}
  .item .sub{font-size:11.5px;color:var(--dim2);margin-top:2px}
  .cols2{display:grid;grid-template-columns:1fr 1fr;gap:12px}
  .big{display:flex;align-items:baseline;gap:12px}
  .big .num{font-size:48px;font-weight:700;letter-spacing:-2px;line-height:1}
  .big .of{font-size:14px;color:var(--dim2)}
  .stages{display:flex;gap:4px;margin:14px 0 8px}
  .stages .st{flex:1;text-align:center;font-size:10.5px;color:var(--dim2);padding:5px 0;border-radius:5px;background:#21262d}
  .stages .st.done{background:#1f6feb33;color:var(--blue)}
  .stages .st.now{background:#1f6feb;color:#fff;font-weight:600}
  .anchor{display:flex;gap:10px;padding:8px 0;border-bottom:1px solid #21262d}
  .anchor:last-child{border-bottom:0}
  .anchor .d{font-size:10.5px;color:var(--dim2);width:62px;flex-shrink:0;padding-top:1px}
  .anchor .e{font-size:12.5px;flex:1}
  .anchor .c{font-size:12px;width:40px;text-align:right;flex-shrink:0}
  .anchor .c.up{color:var(--green)} .anchor .c.dn{color:var(--red)}
  textarea.editor{width:100%;min-height:calc(100vh - 250px);background:#0a0e13;border:1px solid var(--line);border-radius:8px;padding:14px 16px;color:#c9d1d9;font:12.5px/1.7 ui-monospace,Consolas,monospace;resize:vertical}
  button.btn{background:#21262d;border:1px solid var(--line);color:var(--text);padding:7px 14px;border-radius:6px;cursor:pointer;font-size:12.5px;font-family:inherit}
  button.btn:hover{background:#2d333b}
  button.btn.pri{background:#238636;border-color:#2ea043;color:#fff}
  .row{display:flex;gap:8px;align-items:center;margin-top:12px;flex-wrap:wrap}
  .hint{font-size:11.5px;color:var(--dim2)}
  /* ---- 状态页 ---- */
  .state-top{display:grid;grid-template-columns:auto 1fr 1fr;gap:16px;align-items:stretch;margin-bottom:12px}
  @media(max-width:900px){.state-top{grid-template-columns:1fr}}
  .state-face{background:linear-gradient(145deg,#1a2130,#151a24);border:1px solid var(--line);border-radius:14px;padding:20px 24px;display:flex;flex-direction:column;align-items:center;justify-content:center;min-width:170px}
  .state-avatar{width:52px;height:52px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:22px;font-weight:600;color:#0d1117;margin-bottom:10px}
  .state-name{font-size:15px;font-weight:600;color:var(--text)}
  .state-phase{font-size:11.5px;color:var(--dim2);margin-top:4px}
  .state-mood,.state-rel{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:18px 20px;display:flex;flex-direction:column;justify-content:center}
  .sm-k{font-size:11px;color:var(--dim2);margin-bottom:8px}
  .sm-k b{color:var(--text);font-weight:600}
  .sm-v{font-size:24px;font-weight:600;color:var(--text);line-height:1.1;font-variant-numeric:tabular-nums}
  .sm-v small{font-size:12px;color:var(--dim);font-weight:400;margin-left:2px}
  .sm-bar{height:4px;background:#232a38;border-radius:2px;margin:10px 0 8px;overflow:hidden}
  .sm-bar i{display:block;height:100%;background:linear-gradient(90deg,#58a6ff,#bc8cff);border-radius:2px;transition:width .5s ease}
  .sm-s{font-size:11px;color:var(--dim2)}
  .state-think{font-size:13.5px;line-height:1.9;color:var(--text);white-space:pre-wrap}
  /* ---- 移动端预留：后续要完整适配时从这里改 ---- */
  /* 断点：768px（手机）、1024px（平板）。现在只做"能用"，没做完整重排。 */
  @media(max-width:768px){
    body{--mobile:1}
    .sidebar{width:60px}
    .sidebar .logo,.sidebar nav button span:not(.ico){display:none}
    .main{padding:12px}
    .hero{grid-template-columns:1fr}
    .hero-stats{grid-template-columns:repeat(2,1fr)}
    .grid2,.cols2{grid-template-columns:1fr}
    .try-layout{grid-template-columns:1fr}
  }
  .sched{font-size:12.5px;line-height:2.1;color:var(--dim)}
  .sched b{color:var(--text);font-weight:600}
  .sched .dim{color:var(--dim2)}
  .row-acts{display:flex;gap:4px;margin-left:auto;flex:none;align-items:flex-start}
  .mini-btn{background:transparent;border:1px solid var(--line);color:var(--dim2);font-size:10.5px;padding:2px 7px;border-radius:5px;cursor:pointer;font-family:inherit;white-space:nowrap}
  .mini-btn:hover{color:var(--text);border-color:#3a4356}
  .mini-btn.danger:hover{color:var(--red);border-color:rgba(248,81,73,.5)}
  /* ---- 人物切换（自定义下拉） ---- */
  .pick{position:relative;display:inline-block}
  .pick-btn{display:flex;align-items:center;gap:8px;background:var(--panel2);border:1px solid var(--line);color:var(--text);font-size:12px;padding:5px 10px;border-radius:7px;cursor:pointer;font-family:inherit;max-width:220px}
  .pick-btn:hover{border-color:#3a4356}
  .pick-avatar{width:18px;height:18px;border-radius:50%;flex:none;display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:600;color:#0d1117}
  .pick-name{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .pick-stage{font-size:10px;color:var(--dim2);flex:none}
  .pick-arrow{color:var(--dim2);font-size:9px;flex:none}
  .pick-menu{position:absolute;top:calc(100% + 6px);left:0;min-width:230px;background:#151a24;border:1px solid var(--line);border-radius:9px;padding:5px;z-index:50;box-shadow:0 12px 32px rgba(0,0,0,.55);display:none}
  .pick-menu.on{display:block}
  .pick-item{display:flex;align-items:center;gap:9px;padding:7px 9px;border-radius:6px;cursor:pointer;font-size:12px;color:var(--dim)}
  .pick-item:hover{background:var(--panel2);color:var(--text)}
  .pick-item.cur{background:rgba(88,166,255,.12);color:var(--blue)}
  .pick-item .pick-avatar{width:20px;height:20px;font-size:10.5px}
  .pick-item .pi-name{flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .pick-item .pi-stage{font-size:10px;color:var(--dim2)}
  /* ---- 试聊 ---- */
  .try-layout{display:grid;grid-template-columns:1fr 380px;gap:12px;align-items:start}
  @media(max-width:1000px){.try-layout{grid-template-columns:1fr}}
  .try-panel .try-body{padding:0;display:flex;flex-direction:column;height:calc(100vh - 190px)}
  .try-log{flex:1;overflow:auto;padding:16px 18px}
  .try-empty{color:var(--dim2);font-size:12.5px;line-height:2;text-align:center;padding:60px 20px}
  .try-input-row{display:flex;gap:8px;padding:12px 16px;border-top:1px solid var(--line)}
  .try-input{flex:1;background:var(--panel2);border:1px solid var(--line);border-radius:8px;color:var(--text);font-size:13px;padding:9px 12px;outline:none;font-family:inherit}
  .try-input:focus{border-color:rgba(88,166,255,.5)}
  .try-stats{display:grid;grid-template-columns:1fr 1fr;gap:9px;margin-bottom:14px}
  .ts{background:var(--panel2);border:1px solid var(--line);border-radius:8px;padding:9px 11px}
  .ts span{display:block;font-size:10.5px;color:var(--dim2);margin-bottom:3px}
  .ts b{font-size:14px;font-weight:600;color:var(--text);font-variant-numeric:tabular-nums}
  .try-prompt summary{cursor:pointer;font-size:11.5px;color:var(--dim2);padding:6px 0}
  .try-prompt pre{font:11px/1.65 ui-monospace,Consolas,monospace;white-space:pre-wrap;background:#0a0e13;padding:12px;border-radius:8px;max-height:320px;overflow:auto;margin-top:6px;color:var(--dim)}
  /* ---- 操作 ---- */
  .ops-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px}
  .op{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:20px;cursor:pointer;transition:border-color .15s,transform .1s}
  .op:hover{border-color:rgba(88,166,255,.45);transform:translateY(-1px)}
  .op:active{transform:translateY(0)}
  .op-ico{font-size:22px;margin-bottom:10px;line-height:1}
  .op-t{font-size:14px;font-weight:600;color:var(--text);margin-bottom:5px}
  .op-d{font-size:11.5px;color:var(--dim2);line-height:1.6}
  /* ---- 日志行（过滤版） ---- */
  .log.tall{max-height:calc(100vh - 210px)}
  .log .line{display:flex;gap:10px;padding:3px 0;font-size:12px;line-height:1.6;font-family:ui-monospace,Consolas,monospace}
  .log .line .t{color:var(--dim2);flex:none;font-variant-numeric:tabular-nums}
  .log .line .lv{flex:none;width:38px;font-size:10.5px;text-transform:uppercase;letter-spacing:.04em}
  .log .line.info .lv{color:var(--dim2)}
  .log .line.warn .lv{color:var(--yellow)}
  .log .line.error .lv{color:var(--red)}
  .log .line.warn .m{color:#e3c07a}
  .log .line.error .m{color:#ff9d97}
  .log .line .m{color:var(--dim);word-break:break-word}
  /* ---- 日志过滤 ---- */
  .log-filter{display:flex;gap:6px;margin-bottom:10px;align-items:center}
  .fbtn{background:var(--panel2);border:1px solid var(--line);color:var(--dim);font-size:11.5px;padding:4px 11px;border-radius:6px;cursor:pointer;font-family:inherit}
  .fbtn:hover{color:var(--text)}
  .fbtn.on{background:rgba(88,166,255,.15);border-color:rgba(88,166,255,.4);color:var(--blue)}
  .log.tall{max-height:calc(100vh - 210px)}
  /* ---- 聊天气泡 ---- */
  .bubble-row{display:flex;margin:10px 0}
  .bubble-row.right{justify-content:flex-end}
  .bubble-row.left{justify-content:flex-start}
  .bubble{max-width:72%;padding:9px 13px;border-radius:13px;font-size:13px;line-height:1.65;word-break:break-word;position:relative}
  .bubble.them{background:#1f6feb;color:#fff;border-bottom-right-radius:4px}
  .bubble.me{background:var(--panel2);color:var(--text);border:1px solid var(--line);border-bottom-left-radius:4px}
  .bubble-text{white-space:pre-wrap}
  .bubble-time{font-size:10px;opacity:.55;margin-top:3px;text-align:right;font-variant-numeric:tabular-nums}
  /* ---- 关系页 ---- */
  .rel-hero{display:flex;gap:28px;align-items:center;background:linear-gradient(145deg,#1a2130,#151a24);border:1px solid var(--line);border-radius:14px;padding:24px 28px;flex-wrap:wrap}
  .rel-ring-wrap{position:relative;width:160px;height:160px;flex:none}
  .ring.big{width:160px;height:160px}
  .ring.big .ring-track{stroke-width:11}
  .ring.big .ring-fill{stroke-width:11}
  .rel-ring-center{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center}
  .rel-num{font-size:38px;font-weight:600;line-height:1;color:var(--text);font-variant-numeric:tabular-nums}
  .rel-of{font-size:12px;color:var(--dim2);margin-top:5px}
  .rel-side{flex:1;min-width:240px}
  .rel-hint{font-size:13px;color:var(--dim);margin-top:12px}
  .rel-mood{font-size:12.5px;color:var(--dim2);margin-top:8px}
  /* ---- 时间线 ---- */
  .timeline{position:relative;padding-left:18px}
  .timeline::before{content:'';position:absolute;left:4px;top:6px;bottom:6px;width:1px;background:var(--line)}
  .tl-item{position:relative;padding:0 0 18px 0}
  .tl-item:last-child{padding-bottom:0}
  .tl-item::before{content:'';position:absolute;left:-17px;top:6px;width:7px;height:7px;border-radius:50%;background:var(--panel2);border:1.5px solid var(--dim2)}
  .tl-item.up::before{border-color:var(--green);background:var(--green)}
  .tl-item.down::before{border-color:var(--red);background:var(--red)}
  .tl-date{font-size:10.5px;color:var(--dim2);margin-bottom:3px;font-variant-numeric:tabular-nums}
  .tl-text{font-size:12.5px;color:var(--text);line-height:1.6}
  .tl-meta{font-size:11px;color:var(--dim2);margin-top:3px}
  /* ---- 总览 hero ---- */
  .hero{display:grid;grid-template-columns:auto 1fr;gap:20px;align-items:stretch;margin-bottom:14px}
  @media(max-width:900px){.hero{grid-template-columns:1fr}}
  .hero-left{background:linear-gradient(145deg,#1a2130,#151a24);border:1px solid var(--line);border-radius:14px;padding:18px 22px;display:flex;flex-direction:column;justify-content:center;min-width:250px}
  .hero-label{font-size:11px;color:var(--dim2);letter-spacing:.08em;text-transform:uppercase;margin-bottom:6px}
  .hero-row{display:flex;align-items:center;gap:16px}
  .ring{width:104px;height:104px;flex:none}
  .ring-track{fill:none;stroke:#232a38;stroke-width:9}
  .ring-fill{fill:none;stroke:url(#ringGrad);stroke-width:9;stroke-linecap:round;transform:rotate(-90deg);transform-origin:60px 60px;transition:stroke-dasharray .6s ease}
  .hero-num .n{font-size:34px;font-weight:600;line-height:1;color:var(--text);font-variant-numeric:tabular-nums}
  .hero-num .d{font-size:12px;color:var(--dim);margin-top:6px}
  .hero-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}
  @media(max-width:1100px){.hero-stats{grid-template-columns:repeat(2,1fr)}}
  .hs{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:14px 16px;display:flex;flex-direction:column;justify-content:center}
  .hs-k{font-size:11px;color:var(--dim2);margin-bottom:6px}
  .hs-v{font-size:22px;font-weight:600;line-height:1.1;color:var(--text);font-variant-numeric:tabular-nums}
  .hs-v small{font-size:12px;color:var(--dim);font-weight:400;margin-left:2px}
  .hs-s{font-size:11px;color:var(--dim2);margin-top:5px}
  /* ---- 趋势图 ---- */
  .trend-wrap{margin-top:4px}
  .trend{width:100%;height:120px;display:block;overflow:visible}
  .trend-axis{display:flex;justify-content:space-between;font-size:10.5px;color:var(--dim2);margin-top:6px;font-variant-numeric:tabular-nums}
  .prose{font-size:12.5px;line-height:1.9;color:var(--dim);white-space:pre-wrap}
  .log.mini{max-height:150px;overflow:auto}
  /* 权限页：标签式编辑 */
  .acc-block{margin-bottom:18px}
  .acc-block:last-child{margin-bottom:0}
  .acc-label{font-size:12px;color:var(--text);margin-bottom:8px;display:flex;gap:8px;align-items:baseline;font-weight:500}
  .acc-label span{font-size:11px;color:var(--dim2);font-weight:400}
  .chips{display:flex;flex-wrap:wrap;gap:6px;min-height:26px}
  .chip{display:inline-flex;align-items:center;gap:7px;padding:4px 9px;border-radius:6px;background:var(--panel2);border:1px solid var(--line);font-size:12px;font-family:ui-monospace,Consolas,monospace;color:var(--text)}
  .chip.danger{border-color:rgba(248,81,73,.35);background:rgba(248,81,73,.08);color:#ff9d97}
  .chip button{background:none;border:none;color:var(--dim2);cursor:pointer;padding:0;font-size:15px;line-height:1;font-family:inherit}
  .chip button:hover{color:var(--red)}
  .chip-empty{font-size:12px;color:var(--dim2);padding:4px 0;font-style:italic}
  .chip-input{width:100%;background:transparent;border:none;border-bottom:1px dashed var(--line);color:var(--text);font-size:12px;padding:7px 0;outline:none;font-family:ui-monospace,Consolas,monospace;margin-top:6px}
  .chip-input::placeholder{color:var(--dim2);font-family:inherit}
  .chip-input:focus{border-bottom-color:var(--blue)}
  .switch-row{display:flex;align-items:center;gap:10px;font-size:13px;cursor:pointer;flex-wrap:wrap}
  .switch-row input{width:15px;height:15px;accent-color:var(--blue);cursor:pointer}
  .switch-row b{color:var(--blue);font-weight:600}
  .ops{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;max-width:640px}
  .op{background:var(--panel);border:1px solid var(--line);border-radius:9px;padding:13px 15px;cursor:pointer}
  .op:hover{border-color:#58a6ff55;background:var(--panel2)}
  .op .n{font-size:13px;font-weight:500}
  .op .d{font-size:11.5px;color:var(--dim2);margin-top:3px}
  .toast{position:fixed;right:20px;bottom:20px;background:var(--panel2);border:1px solid var(--line);padding:10px 14px;border-radius:8px;font-size:12.5px;opacity:0;transition:.2s}
  .toast.on{opacity:1}
  .empty{color:var(--dim2);font-size:12.5px;padding:10px 0}
</style>
</head>
<body>
<aside>
  <div class="brand"><h1>QQ Bot</h1><p id="brand-sub">连接中…</p></div>
  <nav id="nav">
    <button class="on" data-v="overview"><span class="ico">◉</span>总览</button>
    <button data-v="state"><span class="ico">◎</span>状态</button>
    <button data-v="logs"><span class="ico">≡</span>实时日志</button>
    <button data-v="chat"><span class="ico">◌</span>对话</button>
    <button data-v="memory"><span class="ico">◈</span>记忆</button>
    <button data-v="relation"><span class="ico">♥</span>关系</button>
    <button data-v="self"><span class="ico">◎</span>自我</button>
    <button data-v="rules"><span class="ico">⚙</span>规则</button>
    <button data-v="history"><span class="ico">↺</span>历史</button>
    <button data-v="access"><span class="ico">⚿</span>权限</button>
    <button data-v="search"><span class="ico">⌕</span>搜索</button>
    <button data-v="try"><span class="ico">✎</span>试聊</button>
    <button data-v="ops"><span class="ico">⌘</span>操作</button>
  </nav>
  <div class="foot"><span class="dot" id="dot"></span><span id="conn">未连接</span></div>
</aside>

<main>
  <header>
    <span class="t" id="title">总览</span>
    <div class="pick" id="person-pick">
  <button class="pick-btn" id="pick-btn"><span class="pick-avatar" id="pick-av">?</span><span class="pick-name" id="pick-name">—</span><span class="pick-stage" id="pick-stage"></span><span class="pick-arrow">▼</span></button>
  <div class="pick-menu" id="pick-menu"></div>
</div>
    <div class="meta">
      <span>阶段 <b id="h-stage">-</b></span>
      <span>今日 <b id="h-turns">-</b></span>
      <span id="h-model">-</span>
    </div>
  </header>

  <div class="views">
        <section class="view on" id="v-overview">
      <div class="hero">
        <div class="hero-left">
          <div class="hero-label">你们的关系</div>
          <div class="hero-row">
            <svg class="ring" viewBox="0 0 120 120" aria-hidden="true">
              <circle class="ring-track" cx="60" cy="60" r="50" />
              <circle class="ring-fill" id="ov-ring" cx="60" cy="60" r="50" />
            </svg>
            <div class="hero-num">
              <div class="n" id="c-rel">-</div>
              <div class="d" id="c-rel-s">-</div>
            </div>
          </div>
        </div>
        <div class="hero-stats">
          <div class="hs">
            <div class="hs-k">链路</div>
            <div class="hs-v" id="c-link">-</div>
            <div class="hs-s" id="c-link-s">-</div>
          </div>
          <div class="hs">
            <div class="hs-k">今天</div>
            <div class="hs-v" id="c-today">-</div>
            <div class="hs-s" id="c-today-s">-</div>
          </div>
          <div class="hs">
            <div class="hs-k">记忆</div>
            <div class="hs-v" id="c-mem">-</div>
            <div class="hs-s" id="c-mem-s">-</div>
          </div>
          <div class="hs">
            <div class="hs-k">今日花费</div>
            <div class="hs-v" id="c-cost">-</div>
            <div class="hs-s" id="c-cost-s">-</div>
          </div>
        </div>
      </div>

      <div class="grid2">
        <div class="panel">
          <h3>最近 7 天 <span class="r" id="trend-hint"></span></h3>
          <div class="body">
            <div class="trend-wrap">
              <svg class="trend" id="trend-chart" viewBox="0 0 420 120" preserveAspectRatio="none"></svg>
            </div>
            <div class="trend-axis" id="trend-axis"></div>
          </div>
        </div>
        <div class="panel">
          <h3>最近的日志 <span class="r"><a href="#" onclick="go('logs');return false">看全部</a></span></h3>
          <div class="body"><div class="log mini" id="mini-log"></div></div>
        </div>
      </div>

      <div class="grid2" style="margin-top:12px">
        <div class="panel">
          <h3>定时任务 <span class="r">它自己什么时候会动</span></h3>
          <div class="body"><div id="sched-info" class="sched"></div></div>
        </div>
        <div class="panel">
          <h3>它现在怎么看你 <span class="r" id="rel-next"></span></h3>
          <div class="body"><div id="rel-block" class="prose"></div></div>
        </div>
      </div>
    </section>
    <section class="view" id="v-state">
      <div class="state-top">
        <div class="state-face">
          <div class="state-avatar" id="st-avatar">?</div>
          <div class="state-name" id="st-name">还没有名字</div>
          <div class="state-phase" id="st-phase">—</div>
        </div>
        <div class="state-mood">
          <div class="sm-k">此刻的心情</div>
          <div class="sm-v" id="st-mood-emotion">—</div>
          <div class="sm-bar"><i id="st-mood-bar" style="width:0%"></i></div>
          <div class="sm-s" id="st-mood-at"></div>
        </div>
        <div class="state-rel">
          <div class="sm-k">和 <b id="st-who">你</b> 的关系</div>
          <div class="sm-v"><span id="st-rel-num">0</span><small>/100</small></div>
          <div class="sm-s" id="st-rel-stage">—</div>
        </div>
      </div>

      <div class="grid2" style="margin-top:12px">
        <div class="panel">
          <h3>它现在在想什么</h3>
          <div class="body">
            <div class="state-think" id="st-thinking">（还没想）</div>
            <div class="hint" id="st-about" style="margin-top:14px"></div>
          </div>
        </div>
        <div class="panel">
          <h3>它自己那边 <span class="r">和对话无关的生活</span></h3>
          <div class="body" style="max-height:260px;overflow:auto"><div id="st-life"></div></div>
        </div>
      </div>

      <div class="grid2" style="margin-top:12px">
        <div class="panel">
          <h3>它记着要问你的事 <span class="r" id="st-open-n"></span></h3>
          <div class="body"><div id="st-open"></div></div>
        </div>
        <div class="panel">
          <h3>今天的活动</h3>
          <div class="body"><div id="st-today" class="sched"></div></div>
        </div>
      </div>
    </section>

    <section class="view" id="v-logs">

      <div class="panel">
        <h3>实时流 <span class="r">SSE · 只保留最近 300 条</span></h3>
        <div class="body">
          <div class="log-filter" id="log-filter">
            <button class="fbtn on" data-lv="all">全部</button>
            <button class="fbtn" data-lv="info">info</button>
            <button class="fbtn" data-lv="warn">warn</button>
            <button class="fbtn" data-lv="error">error</button>
            <span class="hint" id="log-count" style="margin-left:auto"></span>
          </div>
          <div class="log tall" id="full-log"></div>
        </div>
      </div>
    </section>

    <section class="view" id="v-chat">
      <div class="panel"><h3>对话 <span class="r" id="chat-date"></span></h3>
        <div class="body">
          <div class="row" style="margin-top:0;margin-bottom:12px">
            <input type="date" id="date-pick" class="btn" style="color-scheme:dark">
            <button class="btn" onclick="loadChat()">查看这一天</button>
          </div>
          <div id="chat-list"></div>
        </div>
      </div>
    </section>

    <section class="view" id="v-memory">
      <div class="panel" style="margin-bottom:12px"><h3>他是谁 <span class="r">画像，整理时更新</span></h3>
        <div class="body"><div id="m-profile" style="font-size:13px;line-height:1.8;white-space:pre-wrap"></div></div>
      </div>
      <div class="cols2">
        <div class="panel"><h3>事实 <span class="r" id="m-facts-n"></span></h3><div class="body"><div id="m-facts"></div></div></div>
        <div class="panel"><h3>待办 / 待确认 <span class="r" id="m-open-n"></span></h3><div class="body"><div id="m-open"></div></div></div>
      </div>
      <div class="cols2" style="margin-top:12px">
        <div class="panel"><h3>经历 <span class="r" id="m-ep-n"></span></h3><div class="body" style="max-height:420px;overflow:auto"><div id="m-ep"></div></div></div>
        <div class="panel"><h3>洞察 <span class="r" id="m-in-n"></span></h3><div class="body" style="max-height:420px;overflow:auto"><div id="m-in"></div></div></div>
      </div>
    </section>

        <section class="view" id="v-relation">
      <div class="rel-hero">
        <div class="rel-ring-wrap">
          <svg class="ring big" viewBox="0 0 160 160">
            <circle class="ring-track" cx="80" cy="80" r="68" stroke-width="11" />
            <circle class="ring-fill" id="r-ring" cx="80" cy="80" r="68" stroke-width="11" />
          </svg>
          <div class="rel-ring-center">
            <div class="rel-num" id="r-num">0</div>
            <div class="rel-of">/ 100</div>
          </div>
        </div>
        <div class="rel-side">
          <div class="stages" id="r-stages"></div>
          <div class="rel-hint" id="r-hint"></div>
          <div class="rel-mood" id="r-mood"></div>
        </div>
      </div>
      <div class="panel" style="margin-top:12px">
        <h3>锚点 <span class="r">每次变化都有理由</span></h3>
        <div class="body" style="max-height:460px;overflow:auto">
          <div class="timeline" id="r-anchors"></div>
        </div>
      </div>
    </section>
<section class="view" id="v-self">
      <div class="cols2">
        <div class="panel"><h3>我是谁 <span class="r" id="self-phase"></span></h3>
          <div class="body">
            <div style="margin-bottom:14px">
              <div class="hint">名字</div>
              <div style="font-size:20px;font-weight:600;margin-top:4px" id="self-name">—</div>
              <div class="hint" id="self-name-why" style="margin-top:4px"></div>
            </div>
            <div style="margin-bottom:14px">
              <div class="hint">对自己的认识</div>
              <div style="font-size:13px;margin-top:4px;white-space:pre-wrap" id="self-about"></div>
            </div>
            <div>
              <div class="hint">最近在想</div>
              <div style="font-size:13px;margin-top:4px;white-space:pre-wrap" id="self-thinking"></div>
            </div>
          </div>
        </div>
        <div class="panel"><h3>我自己的事 <span class="r">和对方无关的那些</span></h3>
          <div class="body" style="max-height:520px;overflow:auto"><div id="self-life"></div></div>
        </div>
      </div>
    </section>

    <section class="view" id="v-rules">
      <div class="panel"><h3>persona/rules.yaml <span class="r">保存后自动重载</span></h3>
        <div class="body">
          <textarea class="editor" id="rules-text" spellcheck="false"></textarea>
          <div class="row">
            <button class="btn pri" onclick="saveRules()">保存</button>
            <button class="btn" onclick="loadRules()">重新读取</button>
            <span class="hint" id="rules-hint"></span>
          </div>
        </div>
      </div>
    </section>

    <section class="view" id="v-history">
      <div class="panel"><h3>人格快照 <span class="r">改动后自动保存，最多 50 份</span></h3>
        <div class="body">
          <div class="row" style="margin-top:0">
            <button class="btn" onclick="act('snapshot')">立即快照</button>
            <span class="hint">回滚前会自动把当前状态也存一份</span>
          </div>
          <div id="hist-list" style="margin-top:14px"></div>
        </div>
      </div>
    </section>

    <section class="view" id="v-access">
      <div class="cols2">
        <div class="panel">
          <h3>群 <span class="r" id="acc-g-count"></span></h3>
          <div class="body">
            <div class="acc-block">
              <div class="acc-label">白名单 <span>留空 = 不限制</span></div>
              <div class="chips" id="chips-groupAllow"></div>
              <input class="chip-input" id="input-groupAllow" placeholder="输入群号，回车添加" autocomplete="off">
            </div>
            <div class="acc-block">
              <div class="acc-label">黑名单 <span>永远不理这些群</span></div>
              <div class="chips" id="chips-groupDeny"></div>
              <input class="chip-input" id="input-groupDeny" placeholder="输入群号，回车添加" autocomplete="off">
            </div>
          </div>
        </div>
        <div class="panel">
          <h3>成员 <span class="r" id="acc-m-count"></span></h3>
          <div class="body">
            <div class="acc-block">
              <div class="acc-label">白名单 <span>留空 = 不限制</span></div>
              <div class="chips" id="chips-memberAllow"></div>
              <input class="chip-input" id="input-memberAllow" placeholder="输入 QQ 号，回车添加" autocomplete="off">
            </div>
            <div class="acc-block">
              <div class="acc-label">黑名单 <span>永远不理这些人</span></div>
              <div class="chips" id="chips-memberDeny"></div>
              <input class="chip-input" id="input-memberDeny" placeholder="输入 QQ 号，回车添加" autocomplete="off">
            </div>
          </div>
        </div>
      </div>
      <div class="panel" style="margin-top:12px">
        <div class="body">
          <label class="switch-row">
            <input type="checkbox" id="acc-require-at">
            <span>群里必须 <b>@</b> 它才回复</span>
            <span class="hint">关掉后，群里所有消息都会被处理</span>
          </label>
          <div class="row" style="margin-top:14px">
            <button class="btn pri" onclick="saveAccessPolicy()">保存</button>
            <span class="hint" id="acc-path"></span>
          </div>
        </div>
      </div>
    </section>

        <section class="view" id="v-search">
      <div class="panel">
        <h3>搜索 <span class="r">记忆和日志一起搜</span></h3>
        <div class="body">
          <div class="row" style="margin-top:0">
            <input id="search-input" class="try-input" placeholder="搜什么？比如「四级」或「住院」" style="flex:1">
            <button class="btn pri" onclick="doSearch()">搜</button>
          </div>
          <div class="log-filter" style="margin-top:12px">
            <button class="fbtn on" data-st="all">全部</button>
            <button class="fbtn" data-st="fact">事实</button>
            <button class="fbtn" data-st="open">待办</button>
            <button class="fbtn" data-st="episode">经历</button>
            <button class="fbtn" data-st="raw">对话</button>
            <button class="fbtn" data-st="log">日志</button>
            <span class="hint" id="search-count" style="margin-left:auto"></span>
          </div>
          <div id="search-hits" style="margin-top:14px;max-height:calc(100vh - 320px);overflow:auto"></div>
        </div>
      </div>
    </section>
    <section class="view" id="v-try">
      <div class="try-layout">
        <div class="panel try-panel">
          <h3>试聊 <span class="r">不写 session、不落盘、不评估关系</span></h3>
          <div class="body try-body">
            <div class="try-log" id="try-log">
              <div class="try-empty" id="try-empty">
                在这里打一句话，看它怎么回。<br>
                <span class="hint">走的是和线上完全一样的组装逻辑，但不会污染任何数据。</span>
              </div>
            </div>
            <div class="try-input-row">
              <input id="try-input" class="try-input" placeholder="说点什么，回车发送" autocomplete="off">
              <button class="btn pri" onclick="doTry()">发送</button>
            </div>
          </div>
        </div>
        <div class="panel try-side">
          <h3>这次它看到了什么</h3>
          <div class="body">
            <div id="try-stats" class="try-stats">
              <div class="ts"><span>注入</span><b id="ts-inject">—</b></div>
              <div class="ts"><span>system</span><b id="ts-size">—</b></div>
              <div class="ts"><span>token</span><b id="ts-token">—</b></div>
              <div class="ts"><span>耗时</span><b id="ts-ms">—</b></div>
            </div>
            <details class="try-prompt">
              <summary>展开完整 system prompt</summary>
              <pre id="try-prompt"></pre>
            </details>
          </div>
        </div>
      </div>
    </section>

    <section class="view" id="v-ops">
      <div class="ops-grid">
        <div class="op" onclick="act('speak')">
          <div class="op-ico">💬</div>
          <div class="op-t">让它说一句</div>
          <div class="op-d">立刻发一条，不看阶段闸门</div>
        </div>
        <div class="op" onclick="act('distill')">
          <div class="op-ico">🧠</div>
          <div class="op-t">立刻整理记忆</div>
          <div class="op-d">把今天的对话压成 episode / facts</div>
        </div>
        <div class="op" onclick="act('snapshot')">
          <div class="op-ico">📸</div>
          <div class="op-t">立刻快照</div>
          <div class="op-d">在改东西之前存一份，能回滚</div>
        </div>
        <div class="op" onclick="act('reload')">
          <div class="op-ico">↻</div>
          <div class="op-t">重载规则</div>
          <div class="op-d">重读 rules.yaml，不用重启</div>
        </div>
        <div class="op" onclick="doExport()">
          <div class="op-ico">⤓</div>
          <div class="op-t">导出备份</div>
          <div class="op-d">所有人 + 记忆 + 最近对话，一个 JSON</div>
        </div>
      </div>
      <div class="panel" style="margin-top:12px">
        <h3>危险操作 <span class="r">回滚请去「历史」页</span></h3>
        <div class="body">
          <div class="op-d">回滚人格、清空记忆这类操作会二次确认，目前放在各自页面里。</div>
        </div>
      </div>
    </section>

  </div>
</main>

<div class="toast" id="toast"></div>

<script>
const token = new URLSearchParams(location.search).get('token') || localStorage.getItem('qqbot-token') || ''
if (token) localStorage.setItem('qqbot-token', token)

/** 当前在看谁的档案。空 = 后端用默认（主人） */
let currentPerson = localStorage.getItem('qqbot-person') || ''

const $ = (id) => document.getElementById(id)
const el = (tag, cls, text) => {
  const n = document.createElement(tag)
  if (cls) n.className = cls
  if (text !== undefined) n.textContent = text
  return n
}
function toast(msg) {
  const t = $('toast')
  t.textContent = msg
  t.classList.add('on')
  setTimeout(() => t.classList.remove('on'), 2200)
}
async function api(path, init) {
  // token 走 header，不拼在 URL 里：URL 会进浏览器历史和 Referer
  const headers = { 'x-console-token': token, ...(init?.headers || {}) }
  // person 不敏感，仍放 query，后端用 searchParams 读
  let url = path
  if (currentPerson) {
    const sep = path.includes('?') ? '&' : '?'
    url = `${path}${sep}person=${encodeURIComponent(currentPerson)}`
  }
  const res = await fetch(url, { ...init, headers })
  if (!res.ok) throw new Error((await res.text()).slice(0, 200))
  return res.json()
}

// ---------- 导航 ----------
const titles = { overview:'总览', state:'状态', logs:'实时日志', chat:'对话', memory:'记忆', relation:'关系', self:'自我', rules:'规则', history:'历史', access:'权限', search:'搜索', try:'试聊', ops:'操作' }
$('nav').addEventListener('click', (e) => {
  const b = e.target.closest('button')
  if (!b) return
  $('nav').querySelectorAll('button').forEach((x) => x.classList.toggle('on', x === b))
  document.querySelectorAll('.view').forEach((v) => v.classList.toggle('on', v.id === 'v-' + b.dataset.v))
  $('title').textContent = titles[b.dataset.v] || b.textContent
  if (b.dataset.v === 'memory') loadMemory()
  if (b.dataset.v === 'relation') loadRelation()
  if (b.dataset.v === 'self') loadSelf()
  if (b.dataset.v === 'rules') loadRules()
  if (b.dataset.v === 'history') loadHistory()
  if (b.dataset.v === 'access') loadAccessPolicy()
  if (b.dataset.v === 'search') $('search-input')?.focus()
  if (b.dataset.v === 'state') loadState()
  if (b.dataset.v === 'chat') loadChat()
})

// ---------- 状态 ----------
let last = null
async function loadStatus() {
  try {
    const s = await api('/api/status')
    last = s
    $('brand-sub').textContent = s.model ? `模型 ${s.model}` : '无模型（回显模式）'
    $('dot').className = 'dot' + (s.connected ? '' : ' off')
    $('conn').textContent = s.connected ? '链路正常' : '链路断开'
    $('h-stage').textContent = s.relation.stage
    $('h-turns').textContent = s.today.turns
    $('h-model').textContent = s.model || '-'

    void loadTrend()
    renderSched(s)

    renderPicker(s.person)
    if (!currentPerson) currentPerson = s.person.id

    $('c-link').textContent = s.connected ? '在线' : '断开'
    $('c-link').style.color = s.connected ? 'var(--green)' : 'var(--red)'
    $('c-link-s').textContent = `${s.transport} · 运行 ${Math.floor(s.uptimeSec / 60)} 分钟`

    $('c-rel').textContent = s.relation.closeness
    $('c-rel-s').textContent = s.relation.next ? `${s.relation.stage} → ${s.relation.next}` : s.relation.stage
    // 环形进度：用 dasharray 画弧
    const R = 50
    const CIRC = 2 * Math.PI * R
    const pct = Math.max(0, Math.min(100, s.relation.closeness)) / 100
    const ring = $('ov-ring')
    if (ring) {
      ring.style.strokeDasharray = `${(CIRC * pct).toFixed(1)} ${CIRC.toFixed(1)}`
    }

    $('c-today').innerHTML = `${s.today.turns}<small> 条</small>`
    $('c-today-s').textContent = `你发了 ${s.today.userMessages} 条`

    $('c-mem').innerHTML = `${s.memory.facts}<small> 条事实</small>`
    $('c-mem-s').textContent = `${s.memory.episodes} 段经历 · ${s.memory.insights} 条洞察 · ${s.memory.open} 待办`

    if (s.cost) {
      $('c-cost').innerHTML = `¥${s.cost.cny.toFixed(2)}`
      $('c-cost-s').textContent = `${s.cost.calls} 次调用 · ${(s.cost.total / 1000).toFixed(1)}k token`
    }

    $('rel-next').textContent = s.relation.next && s.relation.nextAt != null
      ? `距「${s.relation.next}」还差 ${Math.ceil(s.relation.nextAt - s.relation.closeness)}`
      : '已到顶'
    $('rel-block').textContent = s.relationBlock || '（还没有关系数据）'
  } catch (err) {
    $('conn').textContent = '请求失败'
    $('dot').className = 'dot off'
  }
}

// ---------- 日志 ----------
const LOG_MAX = 300
function addLog(rec, target) {
  const box = $(target)
  const row = el('div')
  const d = new Date(rec.ts)
  const t = `${String(d.getHours()).padStart(2,'0')}:${String(d.getMinutes()).padStart(2,'0')}:${String(d.getSeconds()).padStart(2,'0')}`
  row.appendChild(el('span', 'ts', t))
  row.appendChild(el('span', 'lvl ' + rec.level, rec.level))
  const msg = el('span', '', rec.msg + (rec.extra ? '  ' + JSON.stringify(rec.extra) : ''))
  row.appendChild(msg)
  box.appendChild(row)
  while (box.childElementCount > LOG_MAX) box.removeChild(box.firstChild)
  box.scrollTop = box.scrollHeight
}
function connectEvents() {
  const es = new EventSource(`/api/events?token=${encodeURIComponent(token)}`)
  es.onmessage = (ev) => {
    try {
      const rec = JSON.parse(ev.data)
      logFilter.rows.push(rec)
      if (logFilter.rows.length > LOG_MAX) logFilter.rows.shift()
      renderLogRows()
      addLog(rec, 'mini-log')
    } catch {}
  }
  es.onerror = () => {
    $('dot').className = 'dot off'
  }
}

// ---------- 对话 ----------
async function loadChat() {
  const pick = $('date-pick')
  if (!pick.value) {
    const d = new Date()
    pick.value = `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`
  }
  const box = $('chat-list')
  box.innerHTML = ''
  try {
    const data = await api('/api/raw?date=' + pick.value)
    $('chat-date').textContent = `${data.date} · ${data.turns.length} 条`
    if (!data.turns.length) { box.appendChild(el('div', 'empty', '这一天没有记录')); return }
    for (const t of data.turns) {
      const d = new Date(t.ts)
      const time = `${String(d.getHours()).padStart(2,'0')}:${String(d.getMinutes()).padStart(2,'0')}`
      if (t.role === 'user') {
        const row = el('div', 'bubble-row right')
        const b = el('div', 'bubble them')
        b.appendChild(el('div', 'bubble-text', t.text))
        b.appendChild(el('div', 'bubble-time', time))
        row.appendChild(b)
        box.appendChild(row)
        continue
      }
      const row = el('div', 'bubble-row left')
      const b = el('div', 'bubble me')
      b.appendChild(el('div', 'bubble-text', t.text))
      b.appendChild(el('div', 'bubble-time', time))
      row.appendChild(b)
      box.appendChild(row)
      continue
      const item = el('div', 'item')
      const tag = el('span', 'tag ' + (t.role === 'user' ? '' : 'good'), t.role === 'user' ? '他' : '它')
      const body = el('div')
      body.appendChild(el('div', 'txt', t.text))
      body.appendChild(el('div', 'sub', `${time} · ${t.scope}`))
      item.appendChild(tag)
      item.appendChild(body)
      box.appendChild(item)
    }
  } catch (err) { box.appendChild(el('div', 'empty', '加载失败：' + err.message)) }
}

// ---------- 记忆 ----------
async function loadMemory() {
  try {
    const [m, p] = await Promise.all([api('/api/memory'), api('/api/profile')])
    $('m-profile').textContent = p.text || '（还没有画像。事实攒够 3 条后，整理时会自动生成）'
    $('m-facts-n').textContent = m.facts.length
    $('m-open-n').textContent = m.open.length
    $('m-ep-n').textContent = m.episodes.length
    $('m-in-n').textContent = m.insights.length

    const f = $('m-facts'); f.innerHTML = ''
    if (!m.facts.length) f.appendChild(el('div', 'empty', '还没有事实'))
    for (const x of m.facts) {
      const i = el('div', 'item')
      const vis = x.visibility === 'public' ? '公开' : x.visibility === 'private' ? '私密' : '待确认'
      i.appendChild(el('span', 'tag ' + (x.visibility === 'public' ? 'good' : x.visibility === 'unsure' ? 'warn' : ''), vis))
      const b = el('div')
      b.appendChild(el('div', 'txt', x.text))
      b.appendChild(el('div', 'sub', `${x.date} · 置信 ${x.confidence}${x.lastConfirmed && x.lastConfirmed !== x.date ? ' · 确认于 ' + x.lastConfirmed : ''}`))
      if (x.source) b.appendChild(el('div', 'sub', '来源：' + x.source))
      const acts = el('span', 'row-acts')
      const editBtn = el('button', 'mini-btn', '改')
      editBtn.onclick = () => editFactFlow(x)
      const delBtn = el('button', 'mini-btn danger', '删')
      delBtn.onclick = () => delFactFlow(x)
      acts.appendChild(editBtn)
      acts.appendChild(delBtn)
      i.appendChild(b)
      i.appendChild(acts)
      f.appendChild(i)
    }

    const o = $('m-open'); o.innerHTML = ''
    if (!m.open.length) o.appendChild(el('div', 'empty', '没有待办'))
    for (const x of m.open) {
      const i = el('div', 'item')
      i.appendChild(el('span', 'tag ' + (x.kind === 'pending' ? 'warn' : ''), x.kind === 'pending' ? '待确认' : '待办'))
      const b = el('div')
      b.appendChild(el('div', 'txt', x.text))
      b.appendChild(el('div', 'sub', x.date))
      const acts = el('span', 'row-acts')
      const delBtn = el('button', 'mini-btn danger', '删')
      delBtn.onclick = () => delOpenFlow(x)
      acts.appendChild(delBtn)
      i.appendChild(b); i.appendChild(acts); o.appendChild(i)
    }

    const ep = $('m-ep'); ep.innerHTML = ''
    if (!m.episodes.length) ep.appendChild(el('div', 'empty', '还没有经历'))
    for (const x of m.episodes) {
      const i = el('div', 'item')
      const delEp = el('button', 'mini-btn danger', '删')
      delEp.style.marginLeft = 'auto'
      delEp.onclick = () => delEpisodeFlow(x)
      i.appendChild(el('span', 'tag warn', '经历'))
      const b = el('div')
      b.appendChild(el('div', 'txt', x.title))
      b.appendChild(el('div', 'sub', `${x.date} · 重要性 ${x.importance}${x.emotion ? ' · ' + x.emotion : ''}`))
      if (x.body) b.appendChild(el('div', 'sub', x.body))
      i.appendChild(b); ep.appendChild(i)
    }

    const ins = $('m-in'); ins.innerHTML = ''
    if (!m.insights.length) ins.appendChild(el('div', 'empty', '还没有洞察'))
    for (const x of m.insights) {
      const i = el('div', 'item')
      i.appendChild(el('span', 'tag pink', '洞察'))
      const b = el('div')
      b.appendChild(el('div', 'txt', x.text))
      if (x.evidence && x.evidence.length) b.appendChild(el('div', 'sub', '证据：' + x.evidence.join('；')))
      i.appendChild(b); ins.appendChild(i)
    }
  } catch (err) { toast('记忆加载失败：' + err.message) }
}

// ---------- 关系 ----------
async function loadRelation() {
  try {
    const s = await api('/api/status')
    const r = s.relation
    $('r-num').textContent = r.closeness
    const RR = 68
    const RC = 2 * Math.PI * RR
    const rpct = Math.max(0, Math.min(100, r.closeness)) / 100
    const rring = $('r-ring')
    if (rring) rring.style.strokeDasharray = `${(RC * rpct).toFixed(1)} ${RC.toFixed(1)}`
    $('r-hint').textContent = r.next && r.nextAt != null
      ? `离「${r.next}」还差 ${Math.ceil(r.nextAt - r.closeness)}`
      : '已到顶'
    // mood 在顶层（它是全局的，不属于这段关系）
    $('r-mood').textContent = s.mood ? `当前心情：${s.mood.emotion}（${s.mood.intensity.toFixed(1)}）` : '心情：平静'

    const stages = ['陌生','眼熟','朋友','亲近','亲密','离不开']
    const box = $('r-stages'); box.innerHTML = ''
    let passed = true
    for (const name of stages) {
      const d = el('div', 'st' + (name === r.stage ? ' now' : passed ? ' done' : ''), name)
      box.appendChild(d)
      if (name === r.stage) passed = false
    }

    const a = $('r-anchors'); a.innerHTML = ''
    if (!r.anchors.length) a.appendChild(el('div', 'empty', '还没有锚点。普通聊天不会涨关系。'))
    for (const x of r.anchors) {
      const wrap = el('div', 'tl-item ' + (x.direction === 'up' ? 'up' : 'down'))
      wrap.appendChild(el('div', 'tl-date', x.date || ''))
      wrap.appendChild(el('div', 'tl-text', x.event || ''))
      const meta = el('div', 'tl-meta', `${x.dimension} ${x.direction === 'up' ? '+' : '−'}${x.amount}${x.reason ? ' · ' + x.reason : ''}`)
      wrap.appendChild(meta)
      a.appendChild(wrap)
    }
  } catch (err) { toast('关系加载失败：' + err.message) }
}

// ---------- 自我 ----------
const PHASE_LABEL = { sleep: '睡着了', rest: '午后犯懒', active: '醒着' }
async function loadSelf() {
  try {
    const d = await api('/api/self')
    $('self-phase').textContent = PHASE_LABEL[d.phase] || d.phase
    $('self-name').textContent = d.self.name || '还没有名字'
    $('self-name-why').textContent = d.self.nameReason || (d.self.name ? '' : '时机到了它会自己取一个')
    $('self-about').textContent = d.self.about || '（还没想清楚）'
    $('self-thinking').textContent = d.self.thinking || '（还没想）'

    const box = $('self-life')
    box.innerHTML = ''
    if (!d.life.length) {
      box.appendChild(el('div', 'empty', '还没有记录。整理记忆之后会慢慢长出来。'))
    }
    for (const entry of d.life) {
      const h = el('div', 'hint')
      h.style.margin = '10px 0 4px'
      h.textContent = entry.date
      box.appendChild(h)
      for (const line of entry.lines) {
        const i = el('div', 'item')
        i.appendChild(el('span', 'tag pink', '自己'))
        const b = el('div')
        b.appendChild(el('div', 'txt', line))
        i.appendChild(b)
        box.appendChild(i)
      }
    }
  } catch (err) { toast('自我加载失败：' + err.message) }
}

// ---------- 历史 ----------
async function loadHistory() {
  const box = $('hist-list')
  box.innerHTML = ''
  try {
    const d = await api('/api/versions')
    if (!d.snapshots.length) { box.appendChild(el('div', 'empty', '还没有快照')); return }
    for (const s of d.snapshots) {
      const i = el('div', 'item')
      i.appendChild(el('span', 'tag', s.reason === 'auto' ? '自动' : s.reason === 'manual' ? '手动' : s.reason))
      const b = el('div')
      b.appendChild(el('div', 'txt', s.id))
      b.appendChild(el('div', 'sub', s.at ? new Date(s.at).toLocaleString('zh-CN') : '—'))
      i.appendChild(b)
      const btn = el('button', 'btn', '回滚')
      btn.style.marginLeft = 'auto'
      btn.onclick = () => rollback(s.id)
      i.appendChild(btn)
      box.appendChild(i)
    }
  } catch (err) { toast('历史加载失败：' + err.message) }
}
async function rollback(id) {
  if (!confirm(`回滚到 ${id}？\n当前状态会先被快照一份，可以再滚回来。`)) return
  try {
    await api('/api/action', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ action: 'restore', payload: { id } }),
    })
    toast('已回滚到 ' + id)
    loadHistory()
    loadStatus()
  } catch (err) { toast('回滚失败：' + err.message) }
}

// ---------- 权限 ----------
const accState = { groupAllow: [], groupDeny: [], memberAllow: [], memberDeny: [] }
const ACC_KEYS = [
  { key: 'groupAllow', danger: false },
  { key: 'groupDeny', danger: true },
  { key: 'memberAllow', danger: false },
  { key: 'memberDeny', danger: true },
]

function renderAcc() {
  for (const { key, danger } of ACC_KEYS) {
    const box = $('chips-' + key)
    box.innerHTML = ''
    const list = accState[key]
    if (!list.length) {
      box.appendChild(el('span', 'chip-empty', key.endsWith('Deny') ? '（空）' : '（不限制，所有人都可以）'))
      continue
    }
    for (const v of list) {
      const c = el('span', 'chip' + (danger ? ' danger' : ''))
      c.appendChild(el('span', '', v))
      const b = el('button', '', '×')
      b.title = '移除'
      b.onclick = () => {
        accState[key] = accState[key].filter((x) => x !== v)
        renderAcc()
      }
      c.appendChild(b)
      box.appendChild(c)
    }
  }
  $('acc-g-count').textContent = `${accState.groupAllow.length || '不限'} 白 / ${accState.groupDeny.length} 黑`
  $('acc-m-count').textContent = `${accState.memberAllow.length || '不限'} 白 / ${accState.memberDeny.length} 黑`
}

function bindAccInput(key) {
  const input = $('input-' + key)
  input.onkeydown = (e) => {
    if (e.key !== 'Enter') return
    const v = input.value.trim()
    if (!v) return
    if (!accState[key].includes(v)) accState[key].push(v)
    input.value = ''
    renderAcc()
  }
}

async function loadAccessPolicy() {
  try {
    const d = await api('/api/access')
    const p = d.policy
    accState.groupAllow = p.groupAllow.slice()
    accState.groupDeny = p.groupDeny.slice()
    accState.memberAllow = p.memberAllow.slice()
    accState.memberDeny = p.memberDeny.slice()
    $('acc-require-at').checked = p.requireAt
    $('acc-path').textContent = d.path
    renderAcc()
  } catch (err) { toast('权限加载失败：' + err.message) }
}

async function saveAccessPolicy() {
  try {
    await api('/api/access', {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ ...accState, requireAt: $('acc-require-at').checked }),
    })
    toast('已保存，立即生效')
    loadAccessPolicy()
  } catch (err) { toast('保存失败：' + err.message) }
}

for (const { key } of ACC_KEYS) bindAccInput(key)

// ---------- 试聊 ----------
function tryBubble(role, text) {
  const log = $('try-log')
  const empty = $('try-empty')
  if (empty) empty.remove()
  const row = el('div', 'bubble-row ' + (role === 'user' ? 'right' : 'left'))
  const b = el('div', 'bubble ' + (role === 'user' ? 'them' : 'me'))
  b.appendChild(el('div', 'bubble-text', text))
  row.appendChild(b)
  log.appendChild(row)
  log.scrollTop = log.scrollHeight
  return b
}

async function doTry() {
  const input = $('try-input')
  const text = input.value.trim()
  if (!text) return
  input.value = ''
  tryBubble('user', text)
  const b = tryBubble('assistant', '…')

  try {
    const r = await api('/api/try', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ text }),
    })
    b.querySelector('.bubble-text').textContent = r.reply
    $('ts-inject').textContent = `${r.stats.facts}/${r.stats.episodes}/${r.stats.insights}/${r.stats.open}`
    $('ts-size').textContent = `${r.stats.systemChars} 字`
    $('ts-token').textContent = r.usage ? r.usage.total : '—'
    $('ts-ms').textContent = `${(r.elapsedMs / 1000).toFixed(1)}s`
    $('try-prompt').textContent = r.system
    $('try-log').scrollTop = $('try-log').scrollHeight
    input.select()
    return
  } catch (err) {
    b.querySelector('.bubble-text').textContent = '失败：' + err.message
    return
  }
}
$('try-input')?.addEventListener('keydown', (e) => {
  if (e.key === 'Enter') doTry()
})

// ---------- 规则 ----------
async function loadRules() {
  try {
    const r = await api('/api/rules')
    $('rules-text').value = r.text
    $('rules-hint').textContent = r.path
  } catch (err) { toast('规则加载失败：' + err.message) }
}
async function saveRules() {
  try {
    await api('/api/rules', {
      method: 'PUT',
      headers: { 'Content-Type': 'application/yaml' },
      body: $('rules-text').value,
    })
    toast('已保存，自动重载')
  } catch (err) { toast('保存失败：' + err.message) }
}

// ---------- 操作 ----------
async function act(action) {
  try {
    toast('执行中…')
    const r = await api('/api/action', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ action }),
    })
    toast('完成：' + JSON.stringify(r.result).slice(0, 120))
    loadStatus()
  } catch (err) { toast('失败：' + err.message) }
}








// ---------- AI 状态 ----------
const PHASE_LABEL2 = { sleep: '睡着了', rest: '午后犯懒', active: '醒着' }

async function loadState() {
  try {
    const d = await api('/api/state')
    const name = d.name || '还没有名字'
    $('st-avatar').textContent = name.slice(0, 1)
    $('st-avatar').style.background = avatarColor(d.person?.id || 'x')
    $('st-name').textContent = name
    $('st-phase').textContent = PHASE_LABEL2[d.phase] || d.phase

    if (d.mood) {
      $('st-mood-emotion').textContent = d.mood.emotion
      $('st-mood-bar').style.width = Math.round(d.mood.intensity * 100) + '%'
      $('st-mood-at').textContent = '从 ' + new Date(d.mood.at).toLocaleTimeString('zh-CN', { hour12: false }) + ' 开始'
    } else {
      $('st-mood-emotion').textContent = '平静'
      $('st-mood-bar').style.width = '0%'
      $('st-mood-at').textContent = '没有明显情绪'
    }

    $('st-who').textContent = d.person?.name || '你'
    $('st-rel-num').textContent = d.relation.closeness
    $('st-rel-stage').textContent = d.relation.stage + (d.relation.next ? ' → ' + d.relation.next : '')

    $('st-thinking').textContent = d.selfThinking || '（还没想什么）'
    $('st-about').textContent = d.selfAbout ? '它对自己的认识：' + d.selfAbout : ''

    const life = $('st-life')
    life.innerHTML = ''
    if (!d.life?.length) life.appendChild(el('div', 'empty', '还没有。整理记忆时会慢慢长出来。'))
    for (const entry of d.life || []) {
      const h = el('div', 'hint')
      h.style.margin = '8px 0 4px'
      h.textContent = entry.date
      life.appendChild(h)
      for (const line of entry.lines) {
        const i = el('div', 'item')
        i.appendChild(el('span', 'tag pink', '自己'))
        i.appendChild(el('div', '', line))
        life.appendChild(i)
      }
    }

    const openBox = $('st-open')
    openBox.innerHTML = ''
    $('st-open-n').textContent = (d.open?.length || 0) + ' 条'
    if (!d.open?.length) openBox.appendChild(el('div', 'empty', '没有。'))
    for (const o of d.open || []) {
      const i = el('div', 'item')
      i.appendChild(el('span', 'tag ' + (o.kind === 'pending' ? 'warn' : ''), o.kind === 'pending' ? '待确认' : '待办'))
      const b = el('div')
      b.appendChild(el('div', 'txt', o.text))
      b.appendChild(el('div', 'sub', o.date))
      i.appendChild(b)
      openBox.appendChild(i)
    }

    const t = $('st-today')
    const sc = d.scheduler || {}
    const p = sc.proactive || {}
    const lines = [
      `消息　<b>${d.today.turns}</b> 条<span class="dim">（你发了 ${d.today.userMessages} 条）</span>`,
      `记忆　<b>${d.memory.facts}</b> 条事实 · <b>${d.memory.episodes}</b> 段经历 · <b>${d.memory.open}</b> 条待办`,
      `主动　${p.dailyMax > 0 ? `今天 <b>${p.todayCount}</b>/${p.dailyMax}` : '<span class="dim">当前阶段不会主动</span>'}`,
      `整理　${sc.lastDistillAt ? '<b>' + Math.floor((Date.now() - sc.lastDistillAt) / 3600000) + '</b> 小时前' : '<span class="dim">还没整理过</span>'}`,
      `花费　<b>¥${(d.cost?.cny || 0).toFixed(2)}</b><span class="dim">（${d.cost?.calls || 0} 次调用）</span>`,
    ]
    t.innerHTML = lines.join('<br>')
  } catch (err) {
    toast('状态加载失败：' + err.message)
  }
}

// ---------- 定时任务面板 ----------
function renderSched(s) {
  const box = $('sched-info')
  if (!box || !s.scheduler) return
  const sc = s.scheduler
  const p = sc.proactive
  const lines = []

  if (p.dailyMax > 0) {
    const left = Math.max(0, p.dailyMax - p.todayCount)
    lines.push(`主动消息　今天 <b>${p.todayCount}</b>/${p.dailyMax}，还剩 <b>${left}</b> 次`)
    lines.push(`<span class="dim">最短间隔 ${p.minGapHours} 小时${p.lastAt ? ' · 上次 ' + new Date(p.lastAt).toLocaleTimeString('zh-CN', { hour12: false }) : ''}</span>`)
  } else {
    lines.push(`主动消息　<span class="dim">当前阶段不会主动</span>`)
  }

  if (sc.lastDistillAt) {
    const h = Math.floor((Date.now() - sc.lastDistillAt) / 3600000)
    lines.push(`记忆整理　上次 <b>${h < 1 ? '刚刚' : h + ' 小时前'}</b>`)
    lines.push(`<span class="dim">攒够 20 轮或超过 24 小时会自动跑一次</span>`)
  } else {
    lines.push(`记忆整理　<span class="dim">还没整理过</span>`)
  }

  const m = s.mood
  if (m) lines.push(`当前心情　<b>${m.emotion}</b> <span class="dim">强度 ${m.intensity.toFixed(1)}</span>`)

  box.innerHTML = lines.join('<br>')
}

// ---------- 搜索 ----------
let searchType = 'all'
const HIT_LABEL = { fact: '事实', open: '待办', episode: '经历', raw: '对话', log: '日志' }
document.querySelectorAll('#v-search .fbtn').forEach((b) => {
  b.onclick = () => {
    document.querySelectorAll('#v-search .fbtn').forEach((x) => x.classList.remove('on'))
    b.classList.add('on')
    searchType = b.dataset.st
    doSearch()
  }
})
async function doSearch() {
  const q = $('search-input')?.value.trim()
  const box = $('search-hits')
  if (!box) return
  box.innerHTML = ''
  if (!q) { box.appendChild(el('div', 'empty', '输入关键词')); return }
  box.appendChild(el('div', 'empty', '搜索中…'))
  try {
    const types = searchType === 'all' ? '' : '&types=' + searchType
    const d = await api('/api/search?q=' + encodeURIComponent(q) + types)
    box.innerHTML = ''
    $('search-count').textContent = d.hits.length + ' 条'
    if (!d.hits.length) { box.appendChild(el('div', 'empty', '没找到')); return }
    for (const h of d.hits) {
      const i = el('div', 'item')
      i.appendChild(el('span', 'tag ' + (h.kind === 'log' ? 'warn' : h.kind === 'fact' ? 'good' : ''), HIT_LABEL[h.kind] || h.kind))
      const b = el('div')
      b.appendChild(el('div', 'txt', h.title))
      if (h.body) b.appendChild(el('div', 'sub', h.body))
      b.appendChild(el('div', 'sub', h.meta))
      i.appendChild(b)
      box.appendChild(i)
    }
  } catch (err) {
    box.innerHTML = ''
    box.appendChild(el('div', 'empty', '失败：' + err.message))
  }
}
$('search-input')?.addEventListener('keydown', (e) => { if (e.key === 'Enter') doSearch() })

// ---------- 导出 ----------
function doExport() {
  const a = document.createElement('a')
  a.href = '/api/export?token=' + encodeURIComponent(token) + (currentPerson ? '&person=' + encodeURIComponent(currentPerson) : '')
  a.download = ''
  document.body.appendChild(a)
  a.click()
  a.remove()
  toast('开始下载备份')
}

// ---------- 记忆编辑 ----------
async function editFactFlow(x) {
  const next = prompt('改这条事实（留空则不改文字）：', x.text)
  if (next === null) return
  const conf = prompt('置信度 0~1（留空保持不变）：', String(x.confidence))
  if (conf === null) return
  try {
    await api('/api/facts', {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        text: x.text,
        newText: next.trim() || x.text,
        ...(conf.trim() ? { confidence: Number(conf) } : {}),
      }),
    })
    toast('已更新')
    loadMemory()
  } catch (err) { toast('失败：' + err.message) }
}
async function delFactFlow(x) {
  if (!confirm(`删掉这条事实？\n\n${x.text}`)) return
  try {
    await api('/api/facts', {
      method: 'DELETE',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ text: x.text }),
    })
    toast('已删除')
    loadMemory()
  } catch (err) { toast('失败：' + err.message) }
}
async function delOpenFlow(x) {
  if (!confirm(`删掉这条待办？\n\n${x.text}`)) return
  try {
    await api('/api/open', {
      method: 'DELETE',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ text: x.text }),
    })
    toast('已删除')
    loadMemory()
  } catch (err) { toast('失败：' + err.message) }
}
async function delEpisodeFlow(x) {
  if (!confirm(`删掉这段经历？\n\n${x.title}\n\n删了它就想不起来了。`)) return
  try {
    await api('/api/episode', {
      method: 'DELETE',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id: x.id, scope: x.scope }),
    })
    toast('已删除')
    loadMemory()
  } catch (err) { toast('失败：' + err.message) }
}
// ---------- 人物切换器 ----------
const AVATAR_COLORS = ['#58a6ff', '#bc8cff', '#f778ba', '#3fb950', '#d29922', '#79c0ff', '#ff7b72']
function avatarColor(id) {
  let h = 0
  for (let i = 0; i < id.length; i++) h = (h * 31 + id.charCodeAt(i)) >>> 0
  return AVATAR_COLORS[h % AVATAR_COLORS.length]
}
function renderPicker(person) {
  const wrap = $('person-pick')
  if (!wrap) return
  wrap.style.display = person.all.length > 1 ? '' : 'none'
  const cur = person.all.find((p) => p.id === person.id) || person.all[0]
  if (cur) {
    const av = $('pick-av')
    av.textContent = (cur.name || '?').slice(0, 1)
    av.style.background = avatarColor(cur.id)
    $('pick-name').textContent = cur.name || cur.id
    $('pick-stage').textContent = cur.stage || ''
  }
  const menu = $('pick-menu')
  menu.innerHTML = ''
  for (const p of person.all) {
    const item = el('div', 'pick-item' + (p.id === person.id ? ' cur' : ''))
    const av = el('span', 'pick-avatar', (p.name || '?').slice(0, 1))
    av.style.background = avatarColor(p.id)
    item.appendChild(av)
    item.appendChild(el('span', 'pi-name', p.name || p.id))
    item.appendChild(el('span', 'pi-stage', `${p.stage || ''} ${p.closeness ?? ''}`.trim()))
    item.onclick = () => {
      if (p.id !== currentPerson) {
        currentPerson = p.id
        localStorage.setItem('qqbot-person', currentPerson)
        menu.classList.remove('on')
        loadStatus()
        const active = document.querySelector('nav button.on')?.dataset.v
        if (active === 'memory') loadMemory()
        if (active === 'relation') loadRelation()
        if (active === 'self') loadSelf()
      } else {
        menu.classList.remove('on')
      }
    }
    menu.appendChild(item)
  }
}
$('pick-btn').onclick = (e) => {
  e.stopPropagation()
  $('pick-menu').classList.toggle('on')
}
document.addEventListener('click', () => $('pick-menu').classList.remove('on'))
// ---------- 日志级别过滤 ----------
const logFilter = { level: 'all', rows: [] }
function renderLogRows() {
  const box = $('full-log')
  if (!box) return
  const show = logFilter.level === 'all' ? logFilter.rows : logFilter.rows.filter((r) => r.level === logFilter.level)
  box.innerHTML = ''
  for (const r of show.slice(-300)) {
    const line = el('div', 'line ' + r.level)
    line.appendChild(el('span', 't', new Date(r.ts).toLocaleTimeString('zh-CN', { hour12: false })))
    line.appendChild(el('span', 'lv', r.level))
    line.appendChild(el('span', 'm', r.msg + (r.extra ? ' ' + JSON.stringify(r.extra) : '')))
    box.appendChild(line)
  }
  const c = $('log-count')
  if (c) c.textContent = `${show.length} 条`
  box.scrollTop = box.scrollHeight
}
document.querySelectorAll('#log-filter .fbtn').forEach((b) => {
  b.onclick = () => {
    document.querySelectorAll('#log-filter .fbtn').forEach((x) => x.classList.remove('on'))
    b.classList.add('on')
    logFilter.level = b.dataset.lv
    renderLogRows()
  }
})
// ---------- 趋势图 ----------
async function loadTrend() {
  try {
    const d = await api('/api/trend?days=7')
    const svg = $('trend-chart')
    if (!svg) return
    const W = 420, H = 120, PAD = 8
    const pts = d.points
    const max = Math.max(1, ...pts.map((p) => p.turns))
    const stepX = (W - PAD * 2) / Math.max(1, pts.length - 1)
    const coords = pts.map((p, i) => [
      PAD + i * stepX,
      H - PAD - (p.turns / max) * (H - PAD * 2),
    ])
    const line = coords.map(([x, y]) => `${x.toFixed(1)},${y.toFixed(1)}`).join(' ')
    const area = `M${PAD},${H - PAD} L${line.split(' ').join(' L')} L${(W - PAD).toFixed(1)},${H - PAD} Z`
    const dots = coords
      .map(([x, y], i) => (pts[i].turns > 0 ? `<circle cx="${x.toFixed(1)}" cy="${y.toFixed(1)}" r="2.6" fill="#58a6ff"/>` : ''))
      .join('')
    svg.innerHTML = `
      <path d="${area}" fill="url(#areaGrad)"/>
      <polyline points="${line}" fill="none" stroke="#58a6ff" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"/>
      ${dots}
    `
    $('trend-axis').innerHTML = pts.map((p) => `<span>${p.label}</span>`).join('')
    const totalCny = pts.reduce((a, p) => a + (p.cny || 0), 0)
    $('trend-hint').textContent = `最多 ${max} 条/天 · 共 ${pts.reduce((a, p) => a + p.turns, 0)} 条 · ¥${totalCny.toFixed(2)}`
  } catch {
    /* 趋势图失败不影响主面板 */
  }
}
// ---------- 人物切换 ----------


// ---------- 启动 ----------
loadStatus()
connectEvents()
api('/api/logs/recent?n=40')
  .then((rows) => {
    for (const r of rows) {
      logFilter.rows.push(r)
      addLog(r, 'mini-log')
    }
    renderLogRows()
  })
  .catch(() => {})
setInterval(loadStatus, 15000)
</script>
<svg width="0" height="0" style="position:absolute">
  <defs>
    <linearGradient id="ringGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#58a6ff"/>
      <stop offset="100%" stop-color="#bc8cff"/>
    </linearGradient>
    <linearGradient id="areaGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#58a6ff" stop-opacity="0.28"/>
      <stop offset="100%" stop-color="#58a6ff" stop-opacity="0"/>
    </linearGradient>
  </defs>
</svg>
</body>
</html>
