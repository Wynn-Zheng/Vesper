{
  "name": "vesper-desktop",
  "version": "0.1.6",
  "description": "Vesper 控制台的桌面壳",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.vesper.console",
    "productName": "Vesper",
    "directories": {
      "output": "dist"
    },
    "files": ["main.js", "preload.js", "icon.png"],
    "extraResources": [
      { "from": "../src", "to": "app/src" },
      { "from": "../console", "to": "app/console" },
      { "from": "../package.json", "to": "app/package.json" },
      {
        "from": "../node_modules",
        "to": "app/node_modules",
        "filter": ["**/*", "!**/*.md", "!**/test/**", "!**/__tests__/**"]
      }
    ],
    "win": {
      "target": ["nsis"],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
