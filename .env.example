# DeepSeek (leave empty to run in echo mode)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# OneBot reverse WS. This token must match the one you set in NapCat.
ONEBOT_TOKEN=change-me
ONEBOT_HOST=127.0.0.1
ONEBOT_PORT=8765
ONEBOT_PATH=/onebot/v11/ws

# Private chat: only answer this account. Empty = no filter.
OWNER_QQ=

# 群聊总开关。true = 能在群里说话；false = 群里完全不理。
# 桌面版也可以在控制台「设置 → 权限」里改，那边的设置优先级更高（存在 persona/access.yaml）。
ALLOW_GROUP=true
GROUP_ALLOW=
MEMBER_ALLOW=
GROUP_REQUIRE_AT=true

# 上下文压缩：会话里未压缩的历史消息超过该条数时触发压缩（默认 20，正整数）。
CTX_SUMMARY_THRESHOLD=20

# 压缩后保留在原文里的最近消息条数（默认 6，正整数，必须小于 CTX_SUMMARY_THRESHOLD）。
CTX_KEEP_RECENT=6

# 表情：是否在回复里带表情（0 / false / off 关闭，默认 true）。
EMOJI_ENABLED=true

# 表情：每条回复最多带几个（默认 1，超出范围会夹到 0~3）。
EMOJI_MAX_PER_REPLY=1

# 表情：表情库最多保留多少个（默认 200，超出范围会夹到 1~5000）。
EMOJI_LIBRARY_CAP=200

# ---- 控制台 ----
CONSOLE_PORT=7788
# 监听地址。默认 127.0.0.1 = 只有本机能访问。
# 改成 0.0.0.0 = 同一 WiFi 的手机也能打开控制台 —— 但网内任何人都能读记忆、发消息，
# 只在确定要手机访问、且 CONSOLE_TOKEN 足够强时才这么设。
CONSOLE_HOST=127.0.0.1
# 控制台口令（16 位随机串）。留空则每次启动随机生成，重启后旧链接失效。
# 生成：node -e "console.log(require('crypto').randomBytes(8).toString('hex'))"
CONSOLE_TOKEN=

# ---- 更新源（可选，做增量更新包时才需要）----
# 填了才能在控制台「设置 → 关于」里检查更新；不填则该功能不可用。
UPDATE_URL=
UPDATE_TOKEN=


# ---- 发布到自己的更新服务器（只用得到时才需要）----
# scripts/deploy-update.ts 会读这几项；不填就只报错、不会乱传。
# 这些值不要写进仓库（.env 已被 gitignore）。
# DEPLOY_HOST=1.2.3.4
# DEPLOY_PORT=22
# DEPLOY_USER=root
# DEPLOY_PATH=/www/wwwroot/你的站/QQbot
