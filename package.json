{
  "name": "vesper",
  "private": true,
  "type": "module",
  "version": "0.1.7",
  "description": "Vesper（小暮）—— 有记忆、有情绪、会自己反思的 QQ 陪伴体",
  "author": "wynn_zheng <https://github.com/Wynn-Zheng>",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://github.com/Wynn-Zheng/vesper",
  "repository": { "type": "git", "url": "https://github.com/Wynn-Zheng/vesper.git" },
  "contributors": [],
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "start": "node --env-file=.env src/index.ts",
    "mock": "node dev/mock.ts",
    "check": "node node_modules/typescript/bin/tsc --noEmit",
    "check:strict": "node node_modules/typescript/bin/tsc -p tsconfig.strict.json --noEmit --noUnusedLocals",
    "test": "node --test test/*.test.ts",
    "smoke": "node scripts/smoke.ts",
    "smoke:live": "node --env-file=.env scripts/smoke.ts",
    "check-data": "node scripts/check-data.ts",
    "check-config": "node scripts/check-config.ts",
    "check-all": "node scripts/check-all.ts",
    "persona": "node --env-file=.env scripts/persona-check.ts"
  },
  "dependencies": {
    "ws": "^8.18.0",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.18.0",
    "typescript": "^5.7.0"
  }
}
